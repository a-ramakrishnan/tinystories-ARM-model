
# ==========================================
# Python Project .gitignore
# ==========================================

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/
virtualenv/
.python-version

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
secrets.json
credentials.json

# Build and distribution
build/
dist/
*.egg-info/
.eggs/
*.egg
*.whl
pip-wheel-metadata/

# Python packaging
.installed.cfg
MANIFEST

# Testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
test-results/
junit.xml

# Type checking and linting
.mypy_cache/
.pyright/
.ruff_cache/
.pyre/
.dmypy.json
.pytype/

# Jupyter Notebooks
.ipynb_checkpoints/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~
.project
.pydevproject

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# Local databases
*.sqlite
*.sqlite3
*.db

# Application runtime
*.pid
*.pid.lock

# Streamlit
.streamlit/secrets.toml

# ML / AI artifacts
checkpoints/
model_checkpoints/
wandb/
mlruns/
lightning_logs/
tensorboard/
runs/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.h5
*.hdf5

# Local datasets (optional)
data/raw/
data/processed/
datasets/

# Local configuration overrides
config.local.yaml
config.local.json

# Docker overrides
docker-compose.override.yml
